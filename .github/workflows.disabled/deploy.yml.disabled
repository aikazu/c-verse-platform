name: Deploy

# Runbook: docs/08-deployment.md §7
# - push main → build + deploy prod (Pages + Workers)
# - pull_request → build + Pages preview per PR
# - Supabase branching (supabase/**) tetap via supabase-branch-check.yml (preview DB)
# Admin (apps/admin) TIDAK di-deploy ke Pages — VPS/Tunnel terpisah, §3.5

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 12.0.0
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm run typecheck
      - run: pnpm run build
      - name: Supabase migration lint (no DB needed — static checks)
        run: |
          echo "Checking migrations presence..."
          ls -la supabase/migrations/
          echo "Checking RLS on all tables..."
          grep -c "enable row level security" supabase/migrations/*.sql || true
          echo "Checking storage buckets in config..."
          grep -c "storage.buckets" supabase/config.toml || true

  deploy-prod:
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    needs: [test-build]
    runs-on: ubuntu-latest
    env:
      CF_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
      CF_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
      SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 12.0.0
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm run build

      - name: Deploy API → Cloudflare Workers
        run: pnpm --filter @c-verse/api deploy
        # Requires wrangler secrets already set: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, etc. (see §3.3)

      - name: Deploy Web → Cloudflare Pages
        run: pnpm dlx wrangler pages deploy apps/web/dist --project-name cverse-web --branch main
        # Requires CF_API_TOKEN + CF_ACCOUNT_ID

      # Admin is NOT deployed here — VPS + Cloudflare Tunnel (§3.5). Render hint:
      - name: Admin deploy hint
        run: |
          echo "::notice::Admin app (apps/admin) is NOT deployed to Pages. Build artifact: apps/admin/dist — deploy via VPS + cloudflared tunnel to admin.c-verse.co (see docs/08 §3.5 + apps/admin/README.md)."

  deploy-preview:
    if: github.event_name == 'pull_request'
    needs: [test-build]
    runs-on: ubuntu-latest
    env:
      CF_API_TOKEN: ${{ secrets.CF_API_TOKEN }}
      CF_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 12.0.0
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm run build
      - name: Deploy Web Preview → Cloudflare Pages
        run: pnpm dlx wrangler pages deploy apps/web/dist --project-name cverse-web --branch pr-${{ github.event.number }}
        # Preview URL: https://pr-<n>.cverse-web.pages.dev
        # Supabase preview DB is auto-created by Supabase GitHub integration (supabase-branch-check.yml).
