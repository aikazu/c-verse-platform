{
  "name": "c-verse-platform",
  "private": true,
  "version": "0.1.0",
  "description": "C.Verse — Creator Verse platform (C.Card MVP)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @c-verse/web dev",
    "dev:api": "pnpm --filter @c-verse/api dev",
    "dev": "node scripts-dev.mjs",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @c-verse/web build",
    "build:api": "pnpm --filter @c-verse/api build",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "dev:admin": "pnpm --filter @c-verse/admin dev",
    "build:admin": "pnpm --filter @c-verse/admin build",
    "dev:all": "pnpm dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "sync:docs": "node sync-docs.mjs",
    "sync:docs:check": "node sync-docs.mjs --check",
    "sync:docs:reverse": "node sync-docs.mjs --reverse"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.11"
  }
}
