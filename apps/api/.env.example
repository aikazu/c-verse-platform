# C.Verse API (apps/api) — copy ke .dev.vars
# Satu file untuk dua mode: Wrangler (`wrangler dev` baca .dev.vars) dan Node
# (`pnpm dev:node` load .dev.vars via dotenv, lihat src/server.ts).
# Prod: sama persis via `wrangler secret put` — jangan pernah commit nilai asli.

# ── Mode ──
ENV=development

# Public R2 uploads: wrangler dev simulates ASSETS and serves /api/assets locally.
# Leave ASSETS_PUBLIC_URL unset locally; edge uses https://assets.c-verse.co
# from wrangler.toml. Never use the private KYC bucket for avatars/artwork.

# DEV ONLY — one-click demo login (POST /api/auth/demo-login) untuk akun seed
# (supabase/seeds/*.sql) via admin.generateLink. "1"/"true" = aktif.
# JANGAN pernah di-set di production.
ENABLE_DEMO_LOGIN=1

# ── Supabase (WAJIB — API fail-fast tanpa SUPABASE_URL, tidak ada fallback in-memory) ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Auth (Turnstile & SMTP OTP diset di Supabase Dashboard, BUKAN dibaca API) ──

# ── Email (Cloudflare Email Service via `send_email` binding — docs/10 §3.6) ──
# EMAIL_ENABLED=false keeps the transport untouched: sendEmail returns
# { sent:false, reason:'email_disabled' }. The send_email binding only exists
# under wrangler dev/prod — Node dev (tsx) logs the payload instead (redacted).
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@c-verse.co
# Recipient of the cron failure digest (lib/cron.ts) — one summary email per run.
ADMIN_ALERT_EMAIL=admin@cverse.id

# ── NFC (docs/12 — 16 byte hex / 32 karakter; key diversification per-UID N5) ──
# Generate: openssl rand -hex 16
# NFC_MASTER_KEY=

# ── Midtrans (docs/14 — sandbox dulu; IS_PRODUCTION=false) ──
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false

# ── Payout webhook (docs/14 §3.2) ──
# PAYOUT_WEBHOOK_SIGNING_KEY=

# ── Direct Postgres (opsional — untuk tooling; API pakai Supabase client) ──
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
