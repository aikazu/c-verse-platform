# C.Verse API (apps/api) — copy ke .dev.vars
# Satu file untuk dua mode: Wrangler (`wrangler dev` baca .dev.vars) dan Node
# (`pnpm dev:node` load .dev.vars via dotenv, lihat src/server.ts).
# Prod: sama persis via `wrangler secret put` — jangan pernah commit nilai asli.

# ── Mode ──
ENV=development

# DEV ONLY — one-click demo login (POST /api/auth/demo-login) untuk akun seed
# (supabase/seed.sql) via admin.generateLink. "1"/"true" = aktif.
# JANGAN pernah di-set di production.
ENABLE_DEMO_LOGIN=1

# ── Supabase (WAJIB — API fail-fast tanpa SUPABASE_URL, tidak ada fallback in-memory) ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Auth (Turnstile & SMTP OTP diset di Supabase Dashboard, BUKAN dibaca API) ──

# ── Email akses kreator (docs/10 §3.6 — provisioning akun kreator) ──
# EMAIL_ENABLED=false = OFF di dev (sendCreatorAccessEmail return { sent:false, reason:'disabled' }).
# Saat enable: pakai SMTP SumoPod (smtp.sumopod.com:465 tanpa TLS — secure SSL).
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
EMAIL_ENABLED=false

# ── NFC (docs/12 — 16 byte hex / 32 karakter; key diversification per-UID N5) ──
# NFC_MASTER_KEY=

# ── Midtrans (docs/14 — sandbox dulu; IS_PRODUCTION=false) ──
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false

# ── Payout webhook (docs/14 §3.2) ──
# PAYOUT_WEBHOOK_SIGNING_KEY=

# ── Direct Postgres (opsional — untuk tooling; API pakai Supabase client) ──
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
