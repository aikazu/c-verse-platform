# C.Verse API (apps/api) — copy ke .dev.vars
# Satu file untuk dua mode: Wrangler (`wrangler dev` baca .dev.vars) dan Node
# (`pnpm dev:node` load .dev.vars via dotenv, lihat src/server.ts).
# Prod: sama persis via `wrangler secret put` — jangan pernah commit nilai asli.

# ── Mode (wajib eksplisit untuk fallback in-memory; tanpa ini API mati keras tanpa SUPABASE_URL) ──
ENV=development

# ── Supabase (wajib untuk mode DB; kosong = fallback in-memory dev) ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Auth (Turnstile verify server-side; pair dengan VITE_TURNSTILE_SITE_KEY di apps/web) ──
# TURNSTILE_SECRET_KEY=

# ── NFC (docs/12 — 16 byte hex / 32 karakter; key diversification per-UID N5) ──
# NFC_MASTER_KEY=

# ── Midtrans (docs/14 — sandbox dulu; IS_PRODUCTION=false) ──
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false

# ── Payout webhook (docs/14 §3.2) ──
# PAYOUT_WEBHOOK_SIGNING_KEY=

# ── SMTP OTP (Supabase Auth → SumoPod; atau set di Supabase Dashboard) ──
# SMTP_HOST=smtp.sumopod.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# ── Direct Postgres (opsional — untuk tooling/migrasi; API pakai Supabase client) ──
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
