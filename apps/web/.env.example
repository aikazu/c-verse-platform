# C.Verse Web (apps/web) — copy ke .env.local
# Hanya variabel VITE_ (aman di-bundle browser). JANGAN taruh service-role/secret di sini.

# Supabase (Dashboard → Project Settings → API, atau `npx supabase status` untuk lokal)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile widget (captcha login) — Dashboard → Turnstile. Kosongkan untuk dev tanpa captcha.
# VITE_TURNSTILE_SITE_KEY=

# Demo login 1-klik (founder demo only — JANGAN enable di prod)
# VITE_ENABLE_DEMO_LOGIN=1

# Override API base (default: /api diproxy ke :8787 oleh vite.config.ts)
# VITE_API_URL=http://127.0.0.1:8787
