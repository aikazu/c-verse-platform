# C.Verse Admin (apps/admin) — copy ke .env.local
# Anon key saja + RLS + MFA aal2; di belakang Cloudflare Access. Tidak ada service-role di sini.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API base untuk mutasi admin (audited server-side). Kosong = same-origin (prod);
# dev lokal = http://localhost:8787 (API Hono via dev:node/wrangler).
VITE_API_URL=
