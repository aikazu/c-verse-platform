{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "c-verse-admin",
  "main": "worker.ts",
  "account_id": "0252b83dcbeac8879add5c278fbc342d",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "c-verse-api"
    }
  ],
  "routes": [
    {
      "pattern": "admin.c-verse.co",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
