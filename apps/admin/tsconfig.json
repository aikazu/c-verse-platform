{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@c-verse/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["src", "vite.config.ts", "worker.ts", "worker-configuration.d.ts"]
}
