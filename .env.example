# C.Verse — env template (local dev)
# Copy to .env.local (web/admin) and/or apps/api/.dev.vars (Wrangler).
# Prod secrets live in Cloudflare Dashboard / Supabase Dashboard / GitHub Secrets — never in repo.

# ── Vite (apps/web, apps/admin) — prefix VITE_ to expose to browser ──
# Get from: Supabase Dashboard → Project Settings → API (or `npx supabase status` for local)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Turnstile widget (Cloudflare Dashboard -> Turnstile) - captcha login/register
# VITE_TURNSTILE_SITE_KEY=
# Demo login 1-klik (founder demo only - JANGAN enable di prod)
# VITE_ENABLE_DEMO_LOGIN=1
# Optional: override API base (defaults to /api proxied to :8787 in vite.config.ts)
# VITE_API_URL=http://127.0.0.1:8787

# ── API (Hono / Workers) — use .dev.vars for Wrangler, .env.local for Node ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Turnstile secret (server-side verify, pair dengan VITE_TURNSTILE_SITE_KEY)
# TURNSTILE_SECRET_KEY=
# DATABASE_URL — direct Postgres (only for `supabase db` / Drizzle kit if used)
# Pooler (Supavisor, preferred for Workers): postgres://postgres.<ref>:***@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Local: postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ── Workers secrets (set via `wrangler secret put` in prod — never here) ──
# SMTP_HOST=smtp.sumopod.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# NFC_MASTER_KEY=
# PAYOUT_WEBHOOK_SIGNING_KEY=
# FCM_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Domain (docs/08 §3.1) ──
# Primary kemungkinan c-verse.co, secondary c-verse.id redirect.
# WAJIB LOCK sebelum provisioning NFC (NDEF URL permanen di chip).
# C_COIN_RATE_IDR=10000
