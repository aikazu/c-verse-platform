# C.Verse — Environment variables
# Copy this file to .env / .env.local and fill in your Supabase project values.
# For Supabase Branching: each branch gets its own URL/keys automatically;
# production secrets live in Supabase Dashboard + GitHub Secrets, not here.

# ── Vite (frontend) — prefix VITE_ so Vite exposes to browser ──
# Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: override API base (defaults to /api proxied to :8787 in vite.config.ts)
# VITE_API_URL=http://127.0.0.1:8787

# ── API (Hono / Cloudflare Workers) ──
# For `wrangler dev` and `tsx watch` local dev.
# Use .dev.vars (gitignored) for Wrangler; .env.local for Node.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# DATABASE_URL is only needed for direct Postgres (migrations diff / Drizzle if used)
# Session pooler (Supavisor, preferred for Workers): postgres://postgres.<ref>:...@<pooler>/postgres
# Direct: postgres://postgres:postgres@127.0.0.1:54322/postgres  (local supabase db)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# C-Coin config (mirrors packages/shared; override only if testing)
# C_COIN_RATE_IDR=10000
